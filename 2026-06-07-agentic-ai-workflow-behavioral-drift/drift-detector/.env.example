# Database
DATABASE_URL=postgresql://drift:driftpass@localhost:5432/driftdb

# Qdrant Vector Store
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=behavioral_baselines

# Redis (for explainability cache)
REDIS_URL=redis://localhost:6379

# OpenAI (optional — enables LLM drift summaries on alerts)
# OPENAI_API_KEY=sk-...

# Embedding model (local sentence-transformers, no API key needed)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Drift thresholds
DRIFT_ALERT_THRESHOLD=0.65
DRIFT_WARN_THRESHOLD=0.40

# Worker settings
WORKER_POLL_INTERVAL_SECONDS=5
DETECTION_WINDOW_SIZE=10

# API settings
API_HOST=0.0.0.0
API_PORT=8000
SECRET_KEY=change-me-in-production-use-a-long-random-string

# Weights for composite drift score
STRUCTURAL_WEIGHT=0.35
SEMANTIC_WEIGHT=0.40
DISTRIBUTIONAL_WEIGHT=0.25